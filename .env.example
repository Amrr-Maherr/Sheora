# Public Laravel API origin used by the storefront.
# Production builds fail fast when this value is missing.
NEXT_PUBLIC_LARAVEL_API_BASE_URL=https://api.example.com/api/v1

# Legacy json-server origin retained for compatibility with local tooling.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Shared secret for POST /api/revalidate. Use a long random value in production.
HOME_REVALIDATION_SECRET=replace-with-a-long-random-secret
